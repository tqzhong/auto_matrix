import {writeFile} from 'node:fs/promises';import * as THREE from 'three';
import {actor} from './candidate-release/tests/helpers/fighting-hand-fixture.mjs';import {handSurface} from './candidate-release/tests/helpers/hand-surface.mjs';import {advanceMotion,newMotion} from './candidate-release/packages/client/src/agents/CharacterMotion.js';import {FILM_SETS,PILL_ROOM,pillRoot} from '@auto_matrix/shared';
const a=await actor('neo'),b=await actor('neo'),component=(h:any)=>(h.models as any).fightingHands.get(h.rig);
const draw=(h:any,elapsed:number)=>{const pills={role:'neo' as const,choice:'red' as const,phase:'taking' as const,elapsed},center=FILM_SETS.film_lafayette.center,at=pillRoot({...pills,approach:{x:PILL_ROOM.seat,z:PILL_ROOM.z,yaw:-Math.PI/2}});h.rig.root.position.set(center.x+at.x,center.y-1,center.z+at.z);h.rig.root.rotation.y=at.yaw;const input={speed:0,grounded:true,verticalVelocity:0,turn:0,mirror:0,pills},state=newMotion();h.models.animate(h.rig,advanceMotion(state,input,0),state,input,0);h.rig.root.updateMatrixWorld(true);};
try{draw(a,1.8);draw(a,2.7);draw(b,2.7);const rows=[];
for(const side of ['R','L']){const ca=component(a),cb=component(b),ha=ca.binding.hands.find((v:any)=>v.side===side),hb=cb.binding.hands.find((v:any)=>v.side===side),x=ca.shapes.get(ha),y=cb.shapes.get(hb),sa=handSurface(a.rig,side),sb=handSurface(b.rig,side),pa=sa.posePoints(),pb=sb.posePoints(),metrics:any={};
for(const name of ['position','normal','skinIndex','skinWeight']){const aa=sa.group.skin.geometry.attributes[name],bb=sb.group.skin.geometry.attributes[name];let max=0,id=0,k=0;for(const v of sa.vertices)for(let c=0;c<aa.itemSize;c++){const d=Math.abs(aa.getComponent(v,c)-bb.getComponent(v,c));if(d>max){max=d;id=v;k=c;}}metrics[name]={max,id,component:k,actual:aa.getComponent(id,k),expected:bb.getComponent(id,k)};}
let maxDelta=0,deltaAt=0;for(let i=0;i<x.delta.length;i++){const gap=Math.abs(x.delta[i]-y.delta[i]);if(gap>maxDelta){maxDelta=gap;deltaAt=i;}}
rows.push({side,cacheable:ha.cacheable,keysEqual:x.key===y.key,maxDelta,deltaAt,deltaVertex:ha.vertices[Math.floor(deltaAt/3)],metrics,posedMaximum:Math.max(...sa.vertices.map(id=>pa.get(id)!.distanceTo(pb.get(id)!)))});
}await writeFile(new URL('hand-cache-diagnosis.json',import.meta.url),JSON.stringify(rows,null,2)+'\n');console.log(JSON.stringify(rows));}finally{a.models.dispose();b.models.dispose();}
