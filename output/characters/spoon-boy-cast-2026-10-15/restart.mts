import { spawn, execFileSync } from 'node:child_process';
import { readFile, writeFile, mkdir, rm, appendFile, readdir } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { isDeepStrictEqual } from 'node:util';
const folder=fileURLToPath(new URL('./',import.meta.url)),root=path.resolve(folder,'../../..'),runtime=path.join(folder,'runtime-state');
await mkdir(runtime,{recursive:true});
const source=execFileSync(process.execPath,['--import','tsx','scripts/film-review-fixture.mts','m1_spoon','spoon-withdrawal'],{cwd:root,encoding:'utf8'}).trim();
const checkpoint=JSON.parse(await readFile(path.join(source,'world.json'),'utf8'));checkpoint.simulation={running:false,speed:1};
await writeFile(path.join(runtime,'world.json'),JSON.stringify(checkpoint));await rm(source,{recursive:true,force:true});
const env={...process.env,PORT:'3193',HOST:'127.0.0.1',MATRIX_DATA_DIR:runtime,DATABASE_PATH:path.join(runtime,'test.db'),LLM_API_KEY:''};
let server:ReturnType<typeof spawn>|undefined;
async function start(){
 server=spawn(process.execPath,['packages/server/dist/index.js'],{cwd:root,env});
 for(const stream of [server.stdout,server.stderr])stream!.on('data',d=>void appendFile(path.join(folder,'server.log'),d));
 for(let i=0;i<80;i++){
  if(server.exitCode!==null)throw new Error(`isolated server exited: ${server.exitCode}`);
  try{const response=await fetch('http://127.0.0.1:3193/api/world');if(response.ok)return await response.json();}catch{}
  await new Promise(resolve=>setTimeout(resolve,150));
 }
 throw new Error('isolated server did not become ready');
}
async function stop(){const child=server!;await new Promise<void>((resolve,reject)=>{const timer=setTimeout(()=>reject(new Error('server did not stop')),10000);child.once('exit',()=>{clearTimeout(timer);resolve();});child.kill('SIGINT');});server=undefined;}
async function memory(){const dir=path.join(runtime,'memories');const result:Record<string,string>={};for(const name of await readdir(dir).catch(()=>[]))if(name.endsWith('.json'))result[name]=createHash('sha256').update(await readFile(path.join(dir,name))).digest('hex');return result;}
try{
 const before=await start();await writeFile(path.join(folder,'restart-before.json'),JSON.stringify(before));await stop();const memories=await memory();
 const after=await start();await writeFile(path.join(folder,'restart-after.json'),JSON.stringify(after));const afterMemory=await memory();
 const groups=Object.fromEntries(Object.keys(before).map(k=>[k,isDeepStrictEqual(before[k],after[k])]));
 const report={source:'isolated visual-review fixture, generated by the existing playable sequence; not the continuous player save',actualProcessStopped:true,phase:after.sandbox.neoLife.journey.oracle.spoonLesson,publicGroups:groups,memoriesPreserved:isDeepStrictEqual(memories,afterMemory),memoryFiles:Object.keys(memories).length,newNativeGameplay:false};
 await writeFile(path.join(folder,'restart-result.json'),JSON.stringify(report,null,2));console.log(JSON.stringify(report));
 if(Object.values(groups).some(equal=>!equal)||!report.memoriesPreserved)process.exitCode=1;
}finally{if(server)await stop();}
